PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://taxagent:taxagent@localhost:5432/taxagent
DATABASE_POOL_MAX=10

# 32 random bytes, base64 encoded. Never commit the real key.
TAXAGENT_MASTER_KEY_B64=
# Initial management-plane credential. Rotate after bootstrap.
TAXAGENT_BOOTSTRAP_TOKEN=
# off is permitted only outside production. Set required in deployed environments.
TAXAGENT_AUTH_MODE=required

TAXAGENT_NFSE_MODE=mock
TAXAGENT_LIVE_ENABLED=false
TAXAGENT_DPS_BUILDER_MODE=draft
TAXAGENT_DPS_SERIES=1
TAXAGENT_JOB_POLL_MS=1000

NFSE_TEST_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
NFSE_PRODUCTION_BASE_URL=https://sefin.nfse.gov.br/SefinNacional
TAXAGENT_NFSE_DPS_XSD=
