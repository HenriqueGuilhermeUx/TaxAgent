PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://taxagent:taxagent@localhost:5432/taxagent
DATABASE_POOL_MAX=10

TAXAGENT_MASTER_KEY_B64=
TAXAGENT_BOOTSTRAP_TOKEN=
TAXAGENT_AUTH_MODE=required

TAXAGENT_NFSE_MODE=mock
TAXAGENT_LIVE_ENABLED=false
TAXAGENT_DPS_BUILDER_MODE=draft
TAXAGENT_EVENT_BUILDER_MODE=draft
TAXAGENT_DANFSE_RENDERER_MODE=draft
TAXAGENT_DANFSE_ARIAL_PATH=
TAXAGENT_DANFSE_SANS_PATH=
TAXAGENT_DANFSE_LOGO_PATH=
TAXAGENT_DPS_SERIES=1
TAXAGENT_JOB_POLL_MS=1000
TAXAGENT_ROUTING_MODE=assume-national
TAXAGENT_INBOX_IDLE_BACKOFF_MINUTES=60

NFSE_TEST_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
NFSE_PRODUCTION_BASE_URL=https://sefin.nfse.gov.br/SefinNacional
NFSE_TEST_PARAMETERS_BASE_URL=https://adn.producaorestrita.nfse.gov.br
NFSE_PRODUCTION_PARAMETERS_BASE_URL=https://adn.nfse.gov.br
NFSE_PARAMETERS_CONVENTION_PATH_TEMPLATE=/parametrizacao/{cityCode}/convenio
ADN_TEST_CONTRIBUTORS_BASE_URL=https://adn.producaorestrita.nfse.gov.br/contribuintes
ADN_PRODUCTION_CONTRIBUTORS_BASE_URL=https://adn.nfse.gov.br/contribuintes
ADN_CNPJ_QUERY_PARAM=cnpjConsulta
TAXAGENT_NFSE_DPS_XSD=
TAXAGENT_NFSE_EVENT_XSD=

RTC_OPEN_DATA_BASE_URL=https://piloto-cbs.tributos.gov.br/servico/calculadora-consumo/api
RTC_CLASSIFICATIONS_BY_NBS_PATH_TEMPLATE=/calculadora/dados-abertos/classificacoes-tributarias/nbs?nbs={nbs}
RTC_REQUEST_TIMEOUT_MS=15000
